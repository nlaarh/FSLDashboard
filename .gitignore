env/

# Environment variables — ignore EVERY variant, anywhere in the tree.
# Bare ".env" only matches a file named exactly .env; copies/backups like
# ".env copy", ".env.RETIRED-*", "backend/.env.bak" slipped through and each
# carried live Azure/Salesforce/GitHub credentials.
.env
.env*
*.env
*.env.*
backend/.deployment_env.sh

# Node.js / Frontend
frontend/node_modules/
frontend/.vite/
frontend/coverage/

